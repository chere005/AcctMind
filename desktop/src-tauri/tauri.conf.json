{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AcctMind",
  "version": "0.45.0",
  "identifier": "com.seancheren.acctmind.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "sh stage-dist.sh",
    "beforeDevCommand": "sh stage-dist.sh"
  },
  "app": {
    "windows": [
      {
        "title": "AcctMind",
        "width": 480,
        "height": 760,
        "minWidth": 480,
        "maxWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "backgroundColor": "#111111",
        "url": "/AcctMind/index.html"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/128x128.png"
    ],
    "category": "Finance"
  }
}
