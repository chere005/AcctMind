{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // A value computed and never read is usually a feature that silently does
    // not happen. Carried over from CalMind, where a sweep found forty.
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
